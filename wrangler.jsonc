// Cloudflare Worker: phục vụ giao diện (dist/) + API (/api/*) + CSDL D1.
// Lần đầu đưa lên: `npm run cf:setup` (tạo CSDL D1, ghi database_id vào đây), sau đó `npm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "managercal",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "managercal",
      "database_id": "5ff54f86-c6fe-4cc0-90c9-63003caf8875",
      "migrations_dir": "migrations"
    }
  ],
  // Đồng bộ thời gian thực + ai đang online: một Durable Object (SQLite – có trong gói miễn phí)
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    // Số vòng băm mật khẩu. Gói Workers miễn phí giới hạn 10 ms CPU mỗi lượt gọi:
    // nếu đăng nhập báo lỗi vượt CPU, giảm xuống (vd. 20000).
    "PBKDF2_ITERATIONS": "100000"
  },
  "observability": { "enabled": true }
}
