{
  "name": "managercal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler d1 migrations apply managercal --remote && wrangler deploy",
    "dev:cf": "npm run build && wrangler d1 migrations apply managercal --local && wrangler dev --port 8787",
    "cf:setup": "node scripts/cf-setup.mjs",
    "test:e2e:server": "playwright test -c playwright.server.config.ts",
    "deploy:embedded": "npm run build && node scripts/embed-assets.mjs && wrangler d1 migrations apply managercal --remote -c wrangler.embedded.json && wrangler deploy -c wrangler.embedded.json",
    "reset-password": "node scripts/reset-password.mjs",
    "test:e2e:server:phone": "E2E_PHONE=1 playwright test -c playwright.server.config.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.57.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.158.0"
  }
}
